{
  "name": "zet",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time public transport tracking for Zagreb",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --inspect server.js",
    "ingest": "node worker/ingest.js",
    "ingest:dev": "nodemon --watch worker --watch src worker/ingest.js",
    "archive:inspect": "node scripts/inspect-archive.js",
    "analytics:setup": "${PYTHON:-python3} -m venv .venv && .venv/bin/pip install -r analytics/requirements.txt",
    "analytics:static": ".venv/bin/python -m analytics.static_gtfs",
    "analytics:process": ".venv/bin/python -m analytics.process_day"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "protobufjs": "^7.2.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
